# DBZ-App – Umgebungsvariablen (Vorlage). Nie echte Werte ins Repository legen.
# Lokal läuft die App ohne jede Variable (Datei-Speicher, Demo-Konten).

# --- Pflicht in der Produktion ---------------------------------------------------
NODE_ENV=production
# Langer Zufallswert, z. B.: openssl rand -base64 48 (Render erzeugt ihn automatisch)
JWT_SECRET=

# --- Dauerhafte Speicherung (Supabase) --------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional, mit Standardwerten:
# SUPABASE_TABLE=app_state
# SUPABASE_ROW_ID=dbz
# SUPABASE_BUCKET=uploads
# SUPABASE_BACKUP_BUCKET=dbz-backups

# --- Adresse der App (für Links in E-Mails) ---------------------------------------
# Auf Render nicht nötig (RENDER_EXTERNAL_URL wird automatisch gesetzt).
# Bei eigener Domain setzen, z. B. https://app.example.org
# APP_URL=

# --- E-Mail-Versand („Passwort vergessen") ----------------------------------------
# Ohne EMAIL_API_URL wird KEINE E-Mail verschickt; der Link steht dann nur im
# Server-Protokoll und muss von der Verwaltung weitergegeben werden.
# Erwartet einen HTTP-Endpunkt, der { from, to, subject, text, html } als JSON annimmt.
# EMAIL_API_URL=
# EMAIL_API_KEY=
# EMAIL_FROM=DBZ <no-reply@example.org>

# --- Optional ----------------------------------------------------------------------
# Echte Nutzer ohne Supabase (Datei-Speicher mit Platte): keine Demo-Konten im Bestand.
# DBZ_LIVE=1
# Server wach halten (kostenloser Render-Tarif), nur zu diesen Stunden (Europe/Berlin):
# KEEP_AWAKE=1
# KEEP_AWAKE_HOURS=6-23
# Zusätzliche Push-Zustelldienste (kommagetrennt), normalerweise leer:
# PUSH_ALLOWED_HOSTS=
